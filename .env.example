# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요.
# .env.local 은 .gitignore 로 커밋되지 않습니다. 이 예시 파일에는 진짜 값을 넣지 마세요.

# 교사 대시보드 비밀번호 (12자 이상 권장)
TEACHER_PASSWORD=

# 세션 서명용 비밀값 (32자 이상 무작위 문자열)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 Gemini API 키
# 비워 두면 AI 없이 '키워드 채점'으로만 동작합니다.
GEMINI_API_KEY=

# (선택) 채점에 쓸 Gemini 모델 / 그림 생성에 쓸 Imagen 모델
GEMINI_MODEL=gemini-3.5-flash-lite
IMAGEN_MODEL=gemini-3.1-flash-image

# 학급 데이터 자동 삭제까지의 기간(일)
RETENTION_DAYS=30
